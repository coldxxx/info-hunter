# Docker context must never contain private state or local credentials.
.git
**/.git
**/.agents
**/data
**/backups
**/verification
**/connections.local.*
**/env.local
**/.env
**/.env.*
**/*.sqlite*
**/*.db
**/*.db-wal
**/*.db-shm
**/*.pem
**/*.key
**/*.p12
**/*.pfx
**/*.lic

# Rebuild from lockfiles; exclude host dependencies and generated output.
**/node_modules
**/.venv
**/.python
**/__pycache__
**/*.py[cod]
**/*.log
**/*.tsbuildinfo
**/.DS_Store
**/.next
**/.vinext
**/.wrangler
**/dist
**/container-dist
**/out
**/outputs
**/work
**/coverage
**/.cache
